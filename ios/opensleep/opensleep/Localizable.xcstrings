    "guide_accel_desc" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع الهاتف مسطحًا على المرتبة بجانب وسادتك أو تحت الملاءة لتتبّع حركة الجسم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læg telefonen fladt på madrassen ved siden af din pude eller under lagenet for at registrere bevægelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege das Telefon direkt auf die Matratze in die Nähe deines Kissens oder unter das Laken, um körperliche Bewegungen aufzuzeichnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place phone flat on the mattress next to your pillow or under the sheet to track physical movement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca el teléfono plano sobre el colchón cerca de tu almohada o debajo de la sábana para registrar el movimiento físico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez le téléphone à plat sur le matelas près de votre oreiller ou sous le drap pour enregistrer les mouvements physiques."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להניח את הטלפון שטוח על המזרן ליד הכרית או מתחת לסדין כדי לעקוב אחר תנועת הגוף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शरीर की हलचल ट्रैक करने के लिए फ़ोन को तकिए के पास गद्दे पर या चादर के नीचे सपाट रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan ponsel mendatar di kasur di samping bantal atau di bawah seprai untuk melacak gerakan tubuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posiziona il telefono direttamente sul materasso vicino al cuscino o sotto il lenzuolo per registrare i movimenti fisici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体の動きを記録するため、スマートフォンを枕の横のマットレスの上かシーツの下に平らに置いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몸의 움직임을 기록할 수 있도록 휴대폰을 베개 옆 매트리스 위나 시트 아래에 평평하게 놓으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg telefonen flatt på madrassen ved siden av puten eller under lakenet for å registrere bevegelser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg je telefoon plat op het matras naast je kussen of onder het laken om je bewegingen te registreren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połóż telefon płasko na materacu obok poduszki lub pod prześcieradłem, aby śledzić ruchy ciała."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque o telefone diretamente no colchão, perto do travesseiro ou sob o lençol para registrar o movimento físico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положи телефон ровно на матрас рядом с подушкой или под простыню, чтобы отслеживать движения тела."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg telefonen platt på madrassen bredvid kudden eller under lakanet för att registrera dina rörelser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางโทรศัพท์ราบบนที่นอนข้างหมอนหรือใต้ผ้าปูที่นอน เพื่อติดตามการเคลื่อนไหวของร่างกาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiziksel hareketleri takip etmek için telefonu yastığının yanında yatağın üzerine düz şekilde ya da çarşafın altına koy."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поклади телефон рівно на матрац біля подушки або під простирадло, щоб відстежувати рухи тіла."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt điện thoại nằm phẳng trên nệm cạnh gối hoặc dưới ga giường để theo dõi chuyển động cơ thể."
          }
        }
      }
    },
