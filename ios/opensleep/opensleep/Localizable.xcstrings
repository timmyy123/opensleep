    "paywall_feature2_desc" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدعوم بنموذج ذكاء اصطناعي متقدّم من Google يعمل على الجهاز. خاص بنسبة 100% ويعمل دون اتصال."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drevet af en avanceret AI-model fra Google, der kører på enheden. 100 % privat og virker offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angetrieben von einem fortschrittlichen On-Device-KI-Modell von Google. 100% privat und offline nutzbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powered by an advanced on-device AI model from Google. 100% private and offline-capable."
