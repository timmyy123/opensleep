        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google의 고급 온디바이스 AI 모델로 작동해요. 100% 비공개이며 오프라인에서도 사용할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drevet av en avansert AI-modell fra Google som kjører på enheten. 100 % privat og fungerer uten nett."
          }
        },
        "nl" : {
          "stringUnit" : {
