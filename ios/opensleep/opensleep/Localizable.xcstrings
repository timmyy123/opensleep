    "paywall_feature3_desc" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل رسائل غير محدودة واطرح أي سؤال عن النوم دون قيود."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send ubegrænset mange beskeder, og stil alle de søvnspørgsmål, du vil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senden Sie unbegrenzt Nachrichten und stellen Sie jederzeit Schlaf-Fragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send unlimited messages and ask any sleep questions without limits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía mensajes ilimitados y haz cualquier pregunta sobre tu descanso sin límites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez des messages en illimité et posez toutes vos questions sans restriction."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לשלוח הודעות ללא הגבלה ולשאול כל שאלה על שינה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "असीमित मैसेज भेजें और नींद से जुड़ा कोई भी सवाल बिना किसी सीमा के पूछें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirim pesan tanpa batas dan ajukan pertanyaan apa pun tentang tidur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia messaggi illimitati e fai tutte le domande sul sonno senza limiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージは無制限。睡眠に関する質問を何でも気軽にどうぞ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지를 무제한으로 보내고 수면에 관한 무엇이든 마음껏 물어보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send så mange meldinger du vil, og still alle søvnspørsmål uten begrensninger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur onbeperkt berichten en stel al je vragen over slaap, zonder limieten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłaj dowolną liczbę wiadomości i pytaj o sen bez ograniczeń."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie mensagens ilimitadas e tire dúvidas sobre seu sono sem limites."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляй сколько угодно сообщений и задавай любые вопросы о сне без ограничений."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skicka hur många meddelanden du vill och ställ alla dina sömnfrågor utan begränsningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งข้อความได้ไม่จำกัด และถามคำถามเรื่องการนอนได้ทุกเรื่องโดยไม่มีข้อจำกัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sınırsız mesaj gönder ve uykuyla ilgili her şeyi sınır olmadan sor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилай скільки завгодно повідомлень і став будь-які запитання про сон без обмежень."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi tin nhắn không giới hạn và hỏi mọi câu hỏi về giấc ngủ."
          }
        }
      }
    },
