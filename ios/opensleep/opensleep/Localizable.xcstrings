    "paywall_feature4_desc" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع مرة واحدة واستخدمه إلى الأبد. بلا اشتراكات أو رسوم متكررة أو تكاليف خفية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betal én gang, brug for altid. Ingen abonnementer, løbende gebyrer eller skjulte omkostninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal zahlen, für immer nutzen. Keine Abonnements oder wiederkehrende Gebühren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay once, use forever. No subscriptions, recurring fees, or hidden costs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga una vez, úsalo para siempre. Sin suscripciones ni cuotas recurrentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payez une fois, utilisez pour toujours. Aucun abonnement ni frais récurrents."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משלמים פעם אחת ומשתמשים לתמיד. בלי מינויים, חיובים חוזרים או עלויות נסתרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बार भुगतान करें, हमेशा इस्तेमाल करें। कोई सब्सक्रिप्शन, बार-बार लगने वाला शुल्क या छिपी लागत नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayar sekali, gunakan selamanya. Tanpa langganan, biaya berulang, atau biaya tersembunyi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga una volta, usa per sempre. Nessun abbonamento né costi ricorrenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度の支払いでずっと使えます。サブスクリプション、継続課金、隠れた費用は一切ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 결제로 평생 사용하세요. 구독, 정기 요금, 숨겨진 비용이 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betal én gang, bruk for alltid. Ingen abonnementer, løpende gebyrer eller skjulte kostnader."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén keer betalen, voor altijd gebruiken. Geen abonnementen, terugkerende kosten of verborgen kosten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapłać raz, korzystaj zawsze. Bez subskrypcji, opłat cyklicznych i ukrytych kosztów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pague uma vez e use para sempre. Sem assinaturas nem cobranças recorrentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заплати один раз — пользуйся всегда. Без подписок, регулярных платежей и скрытых расходов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betala en gång, använd för alltid. Inga prenumerationer, återkommande avgifter eller dolda kostnader."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จ่ายครั้งเดียว ใช้ได้ตลอดไป ไม่มีการสมัครสมาชิก ค่าบริการรายงวด หรือค่าใช้จ่ายแอบแฝง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kez öde, sonsuza dek kullan. Abonelik, yinelenen ücret ya da gizli maliyet yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заплати один раз — користуйся завжди. Без підписок, регулярних платежів і прихованих витрат."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả một lần, dùng mãi mãi. Không gói đăng ký, không phí định kỳ, không chi phí ẩn."
          }
        }
      }
    },
