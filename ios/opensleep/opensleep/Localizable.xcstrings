    "guide_charger_tip" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نصيحة: أبقِ الهاتف موصولًا بالشاحن لتجنّب استنزاف البطارية بسبب مستشعرات التتبّع."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip: Hold telefonen tilsluttet en oplader, så målesensorerne ikke dræner batteriet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Schließe das Telefon an ein Ladegerät an, um Batterieverbrauch durch die Sensoren zu vermeiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip: Keep the phone plugged into a charger to prevent battery drain from the tracking sensors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: Mantén el teléfono conectado a un cargador para evitar que se agote la batería por los sensores de seguimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conseil : Laissez le téléphone branché à un chargeur pour éviter de décharger la batterie avec les capteurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טיפ: כדאי להשאיר את הטלפון מחובר למטען כדי שחיישני המעקב לא ירוקנו את הסוללה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुझाव: ट्रैकिंग सेंसर से बैटरी खत्म होने से बचाने के लिए फ़ोन को चार्जर से जोड़े रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: Biarkan ponsel tersambung ke pengisi daya agar baterai tidak terkuras oleh sensor pelacakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimento: Tieni il telefono collegato a un caricabatterie per evitare di scaricare la batteria a causa dei sensori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：計測センサーによるバッテリー消費を防ぐため、スマートフォンを充電器につないだままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 측정 센서로 인한 배터리 소모를 막으려면 휴대폰을 충전기에 연결해 두세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: Ha telefonen koblet til en lader, så målesensorene ikke tapper batteriet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip: houd je telefoon aan de oplader, zodat de meetsensoren je batterij niet leegtrekken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskazówka: trzymaj telefon podłączony do ładowarki, aby czujniki śledzenia nie rozładowały baterii."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: Mantenha o telefone conectado a um carregador para evitar o desgaste da bateria pelos sensores de monitoramento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совет: держи телефон на зарядке, чтобы датчики отслеживания не разряжали батарею."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: Ha telefonen ansluten till en laddare så att spårningssensorerna inte tömmer batteriet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เคล็ดลับ: เสียบชาร์จโทรศัพท์ไว้ เพื่อป้องกันไม่ให้เซ็นเซอร์ติดตามทำให้แบตเตอรี่หมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İpucu: Takip sensörlerinin pili tüketmesini önlemek için telefonu şarjda tut."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порада: тримай телефон на зарядці, щоб датчики відстеження не розряджали батарею."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mẹo: Hãy cắm sạc điện thoại để cảm biến theo dõi không làm hao pin."
          }
        }
      }
    },
    "guide_sonar_desc" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع الهاتف على طاولة جانبية ثابتة بجوار السرير، ووجّه الجزء السفلي (السماعة/الميكروفون) نحو جسمك/صدرك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læg telefonen på et stabilt natbord ved siden af sengen. Peg bunden (højttaler/mikrofon) mod din krop/dit bryst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege das Telefon auf eine stabile Oberfläche (wie einen Nachttisch) neben dem Bett. Richte die Unterseite (Lautsprecher/Mikrofon) auf deinen Körper/Brustbereich aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place phone on a stable nightstand next to the bed. Point the bottom (speaker/mic) towards your body/chest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca el teléfono en una superficie estable (como una mesa de noche) al lado de la cama. Apunta la parte inferior (altavoz/micrófono) hacia tu cuerpo/pecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez le téléphone sur une surface stable (comme une table de chevet) à côté du lit. Orientez le bas (haut-parleur/micro) vers votre corps/poitrine."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להניח את הטלפון על שידה יציבה ליד המיטה, כשהחלק התחתון (רמקול/מיקרופון) מופנה לכיוון הגוף/החזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोन को बिस्तर के पास किसी स्थिर नाइटस्टैंड पर रखें। उसका निचला हिस्सा (स्पीकर/माइक) अपने शरीर/सीने की ओर रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan ponsel di meja samping tempat tidur yang stabil. Arahkan bagian bawah (speaker/mikrofon) ke tubuh/dada Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posiziona il telefono su una superficie stabile (come un comodino) accanto al letto. Punta la parte inferiore (altoparlante/microfono) verso il tuo corpo/petto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンをベッド横の安定したナイトテーブルに置き、下部（スピーカー/マイク）を体や胸に向けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰을 침대 옆 안정적인 협탁 위에 놓고, 아랫부분(스피커/마이크)이 몸이나 가슴을 향하게 하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg telefonen på et stødig nattbord ved siden av sengen. Pek bunnen (høyttaler/mikrofon) mot kroppen/brystet ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg je telefoon op een stabiel nachtkastje naast het bed. Richt de onderkant (speaker/microfoon) naar je lichaam/borst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połóż telefon na stabilnej szafce nocnej obok łóżka. Skieruj jego dolną krawędź (głośnik/mikrofon) w stronę ciała/klatki piersiowej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque o telefone em uma superfície estável (como um criado-mudo) ao lado da cama. Aponte a parte inferior (alto-falante/microfone) em direção ao seu corpo/peito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положи телефон на устойчивую прикроватную тумбочку рядом с кроватью. Направь его нижний край (динамик/микрофон) к телу/груди."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placera telefonen på ett stabilt nattduksbord bredvid sängen. Rikta undersidan (högtalare/mikrofon) mot din kropp/bröstkorg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางโทรศัพท์บนโต๊ะข้างเตียงที่มั่นคง หันด้านล่าง (ลำโพง/ไมค์) เข้าหาลำตัว/หน้าอกของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonu yatağın yanındaki sağlam bir komodinin üzerine koy. Alt kısmını (hoparlör/mikrofon) vücuduna/göğsüne doğru çevir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поклади телефон на стійку приліжкову тумбочку біля ліжка. Спрямуй його нижній край (динамік/мікрофон) до тіла/грудей."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt điện thoại trên tủ đầu giường chắc chắn, cạnh giường. Hướng cạnh dưới (loa/micrô) về phía cơ thể/ngực bạn."
          }
        }
      }
    },
