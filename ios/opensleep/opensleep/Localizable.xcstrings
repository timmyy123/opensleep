    "sensor_sonar_desc" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضعه على الطاولة الجانبية موجّهًا نحو صدرك. يستخدم الموجات فوق الصوتية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placer på natbordet rettet mod dit bryst. Bruger ultralyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf den Nachttisch legen, Unterseite zum Körper gerichtet. Verwendet Ultraschall."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place on nightstand pointing towards your chest. Uses ultrasound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca el teléfono en la mesita de noche apuntando a tu pecho. Usa ultrasonido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez le téléphone sur la table de chevet vers votre poitrine. Utilise les ultrasons."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להניח על השידה כשהוא מופנה לכיוון החזה. משתמש באולטרסאונד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नाइटस्टैंड पर अपने सीने की ओर करके रखें। अल्ट्रासाउंड का इस्तेमाल करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan di meja samping tempat tidur, arahkan ke dada Anda. Menggunakan ultrasonik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posiziona il telefono sul comodino rivolto verso il petto. Usa ultrasuoni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ナイトテーブルに置き、胸の方に向けます。超音波を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "협탁 위에 놓고 가슴 쪽을 향하게 하세요. 초음파를 사용해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plasser på nattbordet rettet mot brystet ditt. Bruker ultralyd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg op je nachtkastje, gericht op je borst. Gebruikt ultrageluid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połóż na szafce nocnej, skierowany w stronę klatki piersiowej. Wykorzystuje ultradźwięki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque o telefone no criado-mudo apontado para o peito. Usa ultrassom."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положи телефон на тумбочку и направь его к груди. Использует ультразвук."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placera på nattduksbordet riktad mot bröstkorgen. Använder ultraljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางบนโต๊ะข้างเตียงโดยหันเข้าหาหน้าอก ใช้คลื่นอัลตราซาวด์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komodinin üzerine, göğsüne doğru bakacak şekilde koy. Ultrason kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поклади телефон на тумбочку й спрямуй його до грудей. Використовує ультразвук."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt trên tủ đầu giường, hướng về phía ngực bạn. Sử dụng sóng siêu âm."
          }
        }
      }
    },
