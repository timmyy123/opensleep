    "delete_session_message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف جلسة النوم هذه وبياناتها الصحية نهائيًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne søvnsession og dens sundhedsdata slettes permanent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Schlafsitzung und alle zugehörigen Gesundheitsdaten werden dauerhaft gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sleep session and its health data will be permanently deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sesión de sueño y sus datos de salud se eliminarán de forma permanente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette session de sommeil et ses données de santé seront définitivement supprimées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סשן השינה הזה ונתוני הבריאות שלו יימחקו לצמיתות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह नींद सेशन और इसका हेल्थ डेटा स्थायी रूप से डिलीट हो जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi tidur ini beserta data kesehatannya akan dihapus secara permanen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa sessione di sonno e i suoi dati sanitari verranno eliminati definitivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この睡眠記録とそのヘルスケアデータは完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 수면 기록과 건강 데이터가 영구적으로 삭제됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne søvnøkten og helsedataene for den blir slettet permanent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze slaapsessie en de bijbehorende gezondheidsgegevens worden definitief verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta sesja snu i jej dane zdrowotne zostaną trwale usunięte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sessão de sono e seus dados de saúde serão excluídos permanentemente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот сеанс сна и его данные о здоровье будут удалены навсегда."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här sömnpasset och dess hälsodata raderas permanent."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซสชันการนอนนี้และข้อมูลสุขภาพที่เกี่ยวข้องจะถูกลบอย่างถาวร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uyku oturumu ve sağlık verileri kalıcı olarak silinecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей сеанс сну та його дані про здоров'я буде видалено назавжди."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên ngủ này và dữ liệu sức khỏe của nó sẽ bị xóa vĩnh viễn."
          }
        }
      }
    },
