    "paywall_feature1_desc" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحلّل أنماط نومك ومراحله وجودته ليقدّم لك نصائح مخصّصة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyserer dine søvnmønstre, søvnfaser og søvnkvalitet for at give dig skræddersyede råd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysiert Ihre Schlafmuster, Schlafphasen und Schlafqualität für gezielte Ratschläge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyzes your sleep patterns, stages, and quality to give tailored advice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analiza tus patrones, fases y calidad del sueño para darte consejos prácticos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyse vos cycles, phases et qualité de sommeil pour des conseils sur mesure."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מנתח את דפוסי השינה, השלבים והאיכות שלך כדי לתת עצות מותאמות אישית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके नींद के पैटर्न, चरणों और गुणवत्ता का विश्लेषण करके आपके लिए खास सलाह देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menganalisis pola, tahap, dan kualitas tidur Anda untuk memberikan saran yang sesuai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizza i tuoi schemi, fasi e qualità del sonno per offrirti consigli mirati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠パターン、睡眠段階、睡眠の質を分析して、あなたに合ったアドバイスを提供します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면 패턴, 수면 단계, 수면의 질을 분석해 나에게 맞는 조언을 드려요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyserer søvnmønstre, søvnstadier og søvnkvalitet for å gi deg skreddersydde råd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyseert je slaappatronen, slaapfasen en slaapkwaliteit voor advies op maat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizuje Twoje wzorce snu, fazy i jego jakość, aby dawać dopasowane porady."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analisa seus padrões, fases e qualidade do sono para dar orientações práticas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анализирует закономерности, фазы и качество твоего сна, чтобы давать индивидуальные советы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyserar dina sömnmönster, sömnfaser och sömnkvalitet för att ge skräddarsydda råd."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วิเคราะห์รูปแบบ ระยะ และคุณภาพการนอนของคุณ เพื่อให้คำแนะนำที่เหมาะกับคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana özel tavsiyeler vermek için uyku düzenini, evrelerini ve kaliteni analiz eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аналізує закономірності, фази та якість твого сну, щоб давати індивідуальні поради."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phân tích kiểu ngủ, các giai đoạn và chất lượng giấc ngủ của bạn để đưa ra lời khuyên phù hợp."
