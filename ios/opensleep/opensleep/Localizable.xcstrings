        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Didukung model AI canggih dari Google yang berjalan di perangkat. 100% privat dan bisa digunakan secara offline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
