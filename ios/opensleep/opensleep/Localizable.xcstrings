    "This will permanently delete the %lld selected sleep sessions and their synced health data." : {
      "comment" : "A confirmation message that appears when the user deletes multiple sleep sessions. The argument is the number of sleep sessions that will be deleted.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى حذف جلسات النوم المحددة (%lld) وبياناتها الصحية المتزامنة نهائيًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter permanent de %lld valgte søvnsessioner og deres synkroniserede sundhedsdata."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die %lld ausgewählten Schlafaufzeichnungen und die synchronisierten Gesundheitsdaten dauerhaft gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will permanently delete the %lld selected sleep sessions and their synced health data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará permanentemente las %lld sesiones de sueño seleccionadas y sus datos de salud sincronizados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera définitivement les %lld sessions de sommeil sélectionnées et leurs données de santé synchronisées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו תמחק לצמיתות את %lld סשני השינה שנבחרו ואת נתוני הבריאות המסונכרנים שלהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे चुने गए %lld नींद सेशन और उनका सिंक किया गया हेल्थ डेटा स्थायी रूप से डिलीट हो जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini akan menghapus %lld sesi tidur yang dipilih beserta data kesehatan yang tersinkron secara permanen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo eliminerà definitivamente le %lld sessioni di sonno selezionate e i relativi dati sanitari sincronizzati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した%lld件の睡眠記録と、同期されたヘルスケアデータが完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 수면 기록 %lld개와 동기화된 건강 데이터가 영구적으로 삭제됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter de %lld valgte søvnøktene og de synkroniserte helsedataene deres permanent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden de %lld geselecteerde slaapsessies en de gesynchroniseerde gezondheidsgegevens definitief verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznaczone sesje snu (%lld) i zsynchronizowane z nimi dane zdrowotne zostaną trwale usunięte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso excluirá permanentemente as %lld sessões de sono selecionadas e seus dados de saúde sincronizados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранные сеансы сна (%lld) и их синхронизированные данные о здоровье будут удалены навсегда."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta raderar permanent de %lld valda sömnpassen och deras synkade hälsodata."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการนี้จะลบเซสชันการนอน %lld รายการที่เลือกและข้อมูลสุขภาพที่ซิงค์ไว้อย่างถาวร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen %lld uyku oturumu ve eşitlenmiş sağlık verileri kalıcı olarak silinecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибрані сеанси сну (%lld) та їхні синхронізовані дані про здоров'я буде видалено назавжди."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ xóa vĩnh viễn %lld phiên ngủ đã chọn và dữ liệu sức khỏe đã đồng bộ của chúng."
          }
        }
      }
    },
