    <string name="setting_use_gpu">GPU एक्सेलेरेशन इस्तेमाल करें</string>
    <string name="setting_use_gpu_desc">तेज़ AI जवाबों के लिए फ़ोन का GPU इस्तेमाल करें। CPU इस्तेमाल करने के लिए बंद करें।</string>
    <string name="guide_title">नींद ट्रैकिंग गाइड</string>
    <string name="guide_sonar_title">सोनार (बिना संपर्क)</string>
    <string name="guide_sonar_desc">फ़ोन को बिस्तर के पास किसी स्थिर नाइटस्टैंड पर रखें। उसका निचला हिस्सा (स्पीकर/माइक) अपने शरीर/सीने की ओर रखें।</string>
    <string name="guide_accel_title">एक्सेलेरोमीटर (गद्दा)</string>
    <string name="guide_accel_desc">शरीर की हलचल ट्रैक करने के लिए फ़ोन को तकिए के पास गद्दे पर या चादर के नीचे सपाट रखें।</string>
    <string name="guide_charger_tip">सुझाव: ट्रैकिंग सेंसर से बैटरी खत्म होने से बचाने के लिए फ़ोन को चार्जर से जोड़े रखें।</string>
    <string name="battery_optimization_title">बैटरी ऑप्टिमाइज़ेशन चालू है</string>
    <string name="battery_optimization_desc">सिस्टम के बैटरी सेवर OpenSleep को बैकग्राउंड में बंद कर सकते हैं। सिस्टम सेटिंग में बैटरी ऑप्टिमाइज़ेशन बंद करने के लिए यहाँ टैप करें।</string>

