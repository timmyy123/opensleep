    <string name="guide_title">Guide til søvnmåling</string>
    <string name="guide_sonar_title">Sonar (berøringsfri)</string>
    <string name="guide_sonar_desc">Læg telefonen på et stabilt natbord ved siden af sengen. Peg bunden (højttaler/mikrofon) mod din krop/dit bryst.</string>
    <string name="guide_accel_title">Accelerometer (madras)</string>
    <string name="guide_accel_desc">Læg telefonen fladt på madrassen ved siden af din pude eller under lagenet for at registrere bevægelser.</string>
    <string name="guide_charger_tip">Tip: Hold telefonen tilsluttet en oplader, så målesensorerne ikke dræner batteriet.</string>
    <string name="battery_optimization_title">Batterioptimering er aktiv</string>
    <string name="battery_optimization_desc">OpenSleep kan blive lukket i baggrunden af systemets batterisparefunktioner. Tryk her for at slå batterioptimering fra i systemindstillingerne.</string>

