    <string name="guide_title">Guide för sömnspårning</string>
    <string name="guide_sonar_title">Sonar (kontaktlös)</string>
    <string name="guide_sonar_desc">Placera telefonen på ett stabilt nattduksbord bredvid sängen. Rikta undersidan (högtalare/mikrofon) mot din kropp/bröstkorg.</string>
    <string name="guide_accel_title">Accelerometer (madrass)</string>
    <string name="guide_accel_desc">Lägg telefonen platt på madrassen bredvid kudden eller under lakanet för att registrera dina rörelser.</string>
    <string name="guide_charger_tip">Tips: Ha telefonen ansluten till en laddare så att spårningssensorerna inte tömmer batteriet.</string>
    <string name="battery_optimization_title">Batterioptimering aktiv</string>
    <string name="battery_optimization_desc">OpenSleep kan stängas av i bakgrunden av systemets batterisparfunktioner. Tryck här för att stänga av batterioptimering i systeminställningarna.</string>

